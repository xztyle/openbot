{
  "id": "/app",
  "name": "Atelier",
  "short_name": "Atelier",
  "description": "Chat with your Atelier agents from this browser.",
  "start_url": "/app",
  "scope": "/app",
  "display": "standalone",
  "background_color": "#171411",
  "theme_color": "#171411",
  "icons": [
    {
      "src": "/app-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app-favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
